{
  "name": "@oyai32/new-dialog",
  "version": "1.0.1",
  "description": "NewDialog 组件及文档",
  "type": "module",
  "main": "./dist/new-dialog.umd.cjs",
  "module": "./dist/new-dialog.js",
  "exports": {
    ".": {
      "import": "./dist/new-dialog.js",
      "require": "./dist/new-dialog.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "lib:build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lib:publish": "npm version patch -m 'chore: release %s' && git push --follow-tags && npm run build:lib && npm publish",
    "demo:dev": "vite --open /demo/",
    "api:generate": "node scripts/generate-api-doc.js",
    "changelog:generate": "node scripts/generate-changelog.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "conventional-changelog": "^7.0.0",
    "conventional-changelog-cli": "^2.2.0",
    "jsdom": "^26.1.0",
    "shiki": "^1.29.2",
    "typescript": "^5.0.0",
    "vite": "^7.1.11",
    "vitepress": "^1.0.0",
    "vitest": "^3.2.7",
    "vue": "^3.3.0",
    "vue-docgen-api": "^4.79.2",
    "vue-docgen-cli": "^4.79.0",
    "vue-tsc": "^2.2.12"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.0",
    "vue": "^3.3.0"
  }
}
